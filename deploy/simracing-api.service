# Бэкенд «Сетапы для симрейсинга» (backend/ в репозитории) на hq.
# Код — /opt/simracing-api/src, база SQLite и руководства iRacing — /var/lib/simracing-api.
# Ключ Groq — /etc/simracing-api.env (GROQ_API_KEY=..., права 600). Выкладка — scripts/deploy-hq.sh api
[Unit]
Description=Simracing setups API
After=network.target

[Service]
User=simracing
Group=simracing
WorkingDirectory=/opt/simracing-api/src
EnvironmentFile=/etc/simracing-api.env
Environment=SIMRACING_DATA_DIR=/var/lib/simracing-api
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/simracing-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --proxy-headers --no-server-header
Restart=on-failure
RestartSec=3

# На hq меньше гигабайта памяти, рядом Ultracker: бэкенду хватает ~100 МБ
MemoryMax=300M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/simracing-api

[Install]
WantedBy=multi-user.target
